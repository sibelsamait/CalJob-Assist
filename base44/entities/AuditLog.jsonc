{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Acci\u00f3n realizada (create, update, delete, calculate, export, login)"
    },
    "entity_type": {
      "type": "string",
      "description": "Entidad afectada"
    },
    "entity_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "description": "Detalle del evento para trazabilidad"
    },
    "ip_address": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action",
    "user_email",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}