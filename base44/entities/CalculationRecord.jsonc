{
  "name": "CalculationRecord",
  "type": "object",
  "properties": {
    "calculation_type": {
      "type": "string",
      "enum": [
        "indemnizacion_servicio",
        "aviso_previo",
        "feriado_proporcional",
        "menoscabo_economico",
        "reajuste_real",
        "liquidacion_completa"
      ],
      "description": "Tipo de c\u00e1lculo realizado"
    },
    "tenant_id": {
      "type": "string"
    },
    "input_data": {
      "type": "object",
      "description": "Datos de entrada del c\u00e1lculo"
    },
    "result_data": {
      "type": "object",
      "description": "Resultado detallado del c\u00e1lculo"
    },
    "case_ref": {
      "type": "string",
      "description": "Referencia al caso asociado"
    },
    "uf_value": {
      "type": "number",
      "description": "Valor UF usado en el c\u00e1lculo"
    },
    "calculation_date": {
      "type": "string",
      "format": "date"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Art\u00edculos legales aplicados"
    }
  },
  "required": [
    "calculation_type",
    "tenant_id",
    "input_data",
    "result_data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.tenant_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.tenant_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.tenant_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.tenant_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}