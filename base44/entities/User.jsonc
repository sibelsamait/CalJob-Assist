{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "tenant_id": {
      "type": "string",
      "description": "Identificador de empresa para aislamiento multi-tenant (RUT normalizado)"
    },
    "company_name": {
      "type": "string"
    },
    "company_rut": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "personal",
        "team",
        "enterprise"
      ],
      "default": "personal"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "enterprise"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled"
      ],
      "default": "trialing"
    },
    "subscription_id": {
      "type": "string"
    },
    "profession": {
      "type": "string",
      "description": "Mediador, inspector, abogado, empleador, trabajador, autoridad"
    }
  }
}