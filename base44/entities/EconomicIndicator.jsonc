{
  "name": "EconomicIndicator",
  "type": "object",
  "properties": {
    "indicator_type": {
      "type": "string",
      "enum": [
        "uf",
        "utm",
        "ipc",
        "sueldo_minimo",
        "dolar",
        "euro"
      ],
      "description": "Tipo de indicador econ\u00f3mico"
    },
    "value": {
      "type": "number",
      "description": "Valor del indicador en pesos chilenos"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vigencia del valor"
    },
    "unit": {
      "type": "string",
      "description": "Unidad de medida (pesos, porcentaje)"
    },
    "variation": {
      "type": "number",
      "description": "Variaci\u00f3n porcentual respecto al periodo anterior"
    },
    "source": {
      "type": "string",
      "default": "Banco Central de Chile / mindicador.cl"
    }
  },
  "required": [
    "indicator_type",
    "value",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}